# AutoControl - Archivos a ignorar

# Archivos de configuración con credenciales
.env
.env.local
.env.production
config.php
db_config.php

# Archivos comprimidos
*.zip
*.rar
*.7z
*.tar.gz

# Logs
*.log
logs/
error_log
access_log

# Archivos temporales
*.tmp
*.temp
*.swp
*.swo
*~

# Directorios de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Directorios de IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
nbproject/

# Backups de base de datos (sensibles)
*.sql.bak
backup_*.sql
dump_*.sql

# Archivos de sesión PHP
/Backend/sessions/
/tmp/

# Cache
cache/
*.cache

# Uploads (si hay archivos de usuarios)
uploads/
files/

# Node modules (si se usa Node.js para desarrollo)
node_modules/
package-lock.json

# Composer (si se usa)
vendor/
composer.lock

# Build artifacts
dist/
build/

# Archivos específicos del proyecto que no deben subirse
autocontrol.sql
Autocontrol ACTUALIZADO.7z
*.7z

# Archivos de diagnóstico y temporales del proyecto
SOLUCION_RAPIDA.md
SOLUCION_PROBLEMAS.md
diagnostico.bat
verificar_db.php
test.php
temp_*/

# Configuración local de Claude
.claude/settings.json

# Mantener directorios vacíos
!.gitkeep
